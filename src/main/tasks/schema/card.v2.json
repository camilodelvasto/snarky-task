{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "card.v2.json",
  "title": "snarky-task Card v2 (frontmatter)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "status", "created", "links", "labels", "id"],
  "properties": {
    "v": { "type": "integer", "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["inbox", "active", "waiting", "done", "dropped"] },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "due": { "type": "string" },
    "links": { "type": "array", "items": { "type": "string" } },
    "labels": { "type": "array", "items": { "type": "string" } }
  }
}
