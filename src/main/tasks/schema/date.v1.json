{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "date.v1.json",
  "title": "snarky-task date element data",
  "type": "object",
  "additionalProperties": false,
  "required": ["on"],
  "properties": {
    "on":    { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "label": { "type": "string" },
    "text":  { "type": "string" }
  }
}
